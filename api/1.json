{
  "surah": 1,
  "name": "আল-ফাতিহা",
  "total_ayahs": 7,
  "ayahs": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ",
      "bangla": "দয়াময় পরম দয়ালু আল্লাহ-র নামে",
      "audio_ar": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/ar/1.mp3",
      "audio_bn": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/bn/1.mp3"
    },
    {
      "ayah": 2,
      "arabic": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ",
      "bangla": "সকল প্রশংসা জগতসমূহের প্রতিপালক আল্লাহর-ই,",
      "audio_ar": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/ar/2.mp3",
      "audio_bn": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/bn/2.mp3"
    },
    {
      "ayah": 3,
      "arabic": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ",
      "bangla": "যিনি দয়াময়, পরম দয়ালু,",
      "audio_ar": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/ar/3.mp3",
      "audio_bn": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/bn/3.mp3"
    },
    {
      "ayah": 4,
      "arabic": "مَٰلِكِ يَوْمِ ٱلدِّينِ",
      "bangla": "কর্মফল দিবসের মালিক।",
      "audio_ar": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/ar/4.mp3",
      "audio_bn": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/bn/4.mp3"
    },
    {
      "ayah": 5,
      "arabic": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
      "bangla": "আমরা শুধু তোমারই 'ইবাদত করি, শুধু তোমারই সাহায্য প্রার্থনা করি,",
      "audio_ar": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/ar/5.mp3",
      "audio_bn": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/bn/5.mp3"
    },
    {
      "ayah": 6,
      "arabic": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
      "bangla": "আমাদিগকে সরল পথ প্রদর্শন কর,",
      "audio_ar": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/ar/6.mp3",
      "audio_bn": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/bn/6.mp3"
    },
    {
      "ayah": 7,
      "arabic": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
      "bangla": "তাহাদের পথ, যাহাদিগকে তুমি অনুগ্রহ দান করিয়াছ, তাহাদের পথ নহে যাহারা ক্রোধ-নিপতিত ও পথভ্রষ্ট।",
      "audio_ar": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/ar/7.mp3",
      "audio_bn": "https://raw.githubusercontent.com/mnsadatofficial/quran/main/surah/1/bn/7.mp3"
    }
  ]
}
